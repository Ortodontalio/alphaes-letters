{
  "multipart": [
    {
      "apply": {
        "model": "alphaesletters:block/%1$s"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/%1$s",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/%1$s",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/%1$s",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/strikethrough_block"
      },
      "when": {
        "facing": "north",
        "has_cover": "true"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/strikethrough_block",
        "y": 180
      },
      "when": {
        "facing": "south",
        "has_cover": "true"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/strikethrough_block",
        "y": 90
      },
      "when": {
        "facing": "east",
        "has_cover": "true"
      }
    },
    {
      "apply": {
        "model": "alphaesletters:block/strikethrough_block",
        "y": 270
      },
      "when": {
        "facing": "west",
        "has_cover": "true"
      }
    }
  ]
}